    "receipt": "benchmark/prediction_freeze.json"
  },
  "evaluation": {
    "record_format": "JSONL, one object per line",
    "semantic_policy": "exact canonical label after frozen synonym mapping",
    "paired_errors": "Hungarian assignment maximizing 3D IoU per scene and label",
    "detection_ap": "per-class confidence-ranked greedy matching with all-points interpolation",
    "iou_thresholds": [0.25, 0.5],
    "development_not_heldout": true
  },
  "historical_quarantine": {
    "prepare_slicevote_scene.py": "legacy fixed-proposal ablation only",
    "adapt_slicevote.py": "legacy fixed-proposal ablation only",
    "reason": "Those scripts import Splat Analyzer proposals and masks and are not the pipeline lifter."
  }
}
