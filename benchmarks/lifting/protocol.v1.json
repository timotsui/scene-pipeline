{
  "schema_version": "lifting-benchmark-v1",
  "status": "frozen-corrected-development-run",
  "coordinate_frame": "scene-pipeline raw splat frame",
  "units": "meters",
  "box_type": "axis-aligned, full extents",
  "development_scenes": "hypersim_split.v1.json#development",
  "target_labels": "hypersim_split.v1.json#selection.labels",
  "reconstruction": "reconstruction_recipe.v1.json",
  "base_views": "base_views.v1.json",
  "method": {
    "name": "pipeline lifter",
    "proposal_source": "native GroundingDINO detections and SAM masks",
    "forbidden_inputs": [
      "Splat Analyzer proposals",
